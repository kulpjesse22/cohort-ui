# Real-time is optional. With none of these set the app runs exactly as before:
# a single instance, messages on local disk, presence scoped to that process.
# That is not multiplayer — it is the honest fallback, and it needs no setup.

# Shared message log and presence. Any Upstash Redis database; the REST
# credentials are on its dashboard. Set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the harness sends as `x-cohort-secret` when posting agent
# activity to /api/events. Unset means the ingest is switched off (503) rather
# than open — the status line falls back to its illustrative rotation and says
# so when you open it.
COHORT_EVENTS_SECRET=

# Text-to-speech for the demo narration. Unrelated to any of the above.
ELEVENLABS_API_KEY=
